# Copy to .env and fill in real values. .env is gitignored; this file is not.
# Everything the code reads comes from here — there is no second config file
# and no key is ever hardcoded in a .py or .ipynb.

# ── LLM providers ────────────────────────────────────────────────────────
# Each is optional. A provider with no key is skipped with a printed note
# rather than crashing the run, so a partial key set still produces a
# partial benchmark instead of nothing.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
LLAMA_API_KEY=          # OpenRouter key, used for the Llama models

# ── Market data ──────────────────────────────────────────────────────────
# Polygon is required: it is the only price/news source, so an empty key
# means no benchmark can run at all.
POLYGON_API_KEY=


# ── Optional overrides ───────────────────────────────────────────────────
# Where runs write. Defaults to ./data next to the repo.
# DATA_DIR=

# Model pricing. The built-in table in core/pricing.py is the fallback; point
# these at a JSON to override it when vendor prices change without editing code.
# MODEL_PRICING_JSON=
# MODEL_PRICING_URL=

# DeepSeek off-peak discount pricing applies 16:30-00:30 UTC. Set to 0 to bill
# every DeepSeek call at standard rates regardless of clock time.
# DEEPSEEK_USE_DISCOUNT_WINDOW=1

# Thread-pool width for Polygon fetches, and the throughput stall guard that
# abandons stuck requests (seconds with zero completions).
# MAX_WORKERS=8
# STALL_TIMEOUT=180
