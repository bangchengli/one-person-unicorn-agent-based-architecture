# Secrets — every credential lives in .env, which is never committed.
# The legacy KEY.txt / OAI_CONFIG_LIST / config_api_keys files carried plaintext
# keys INTO git history; they are gone, and these patterns keep them from
# coming back under any name.
.env
.env.*
!.env.example
KEY.txt
OAI_CONFIG_LIST
config_api_keys
*_api_keys

# Python bytecode (regenerated automatically; never useful in git)
__pycache__/
*.py[cod]
*$py.class

# Virtualenv
.venv/
venv/

# IDE / editor settings (personal, machine-specific)
.idea/
.vscode/

# Claude Code session & tooling state
.claude/

# OS cruft
.DS_Store
Thumbs.db

# NOTE: data/analyst_outputs/ and data/cache/ ARE committed on purpose — the
# model outputs behind the paper's tables are the reproducibility record, and
# the caches let the pipeline re-run without re-billing every API call.

# Price parquet cache is regenerable from Polygon and bulky; keep it local.
data/prices/

# Per-run pricing snapshots: one JSON per invocation, unbounded growth.
# The effective pricing that matters is recorded inside each result file.
configs/effective_pricing_*.json

# Charts are regenerated by run.py from the CSVs that ARE committed.
charts/*.png
